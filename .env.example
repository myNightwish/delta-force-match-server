# 复制为 .env 后按需修改
APP_NAME=delta-match
DATABASE_URL=sqlite:///./dev.db
# Docker Compose 内使用: postgresql://postgres:postgres@db:5432/matchdb
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_DAYS=30

# 短信验证码：开发模式直接返回验证码，不真发短信
SMS_DEV_MODE=true
DEV_SMS_CODE=6688

# 匹配费用（分）与取消退款比例
MATCH_FEE_CENTS=100
REFUND_RATE=0.8

UPLOAD_DIR=./uploads

