# Copy to .env for local use; production: set in Render Environment.
APP_ENV=development
CORS_ORIGINS=https://river-delta-web.onrender.com,http://127.0.0.1:5188,http://localhost:5188
PILOT_DB=./pilot.db
PILOT_FREE_MODE=true
PILOT_EXPERIMENT_MODE=false
PILOT_FEE_CENTS=10
ENABLE_LEGACY_API=false
# Production internal statistics stay inaccessible unless a private token is set.
PILOT_METRICS_TOKEN=

# Optional phone login: disabled until a real provider is configured
PHONE_AUTH_ENABLED=false
PHONE_AUTH_PROVIDER=twilio_verify
PHONE_AUTH_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
